# Copy to .env and fill in. NEVER commit .env.
# Primary provider: Google Gemini (free tier) -- https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional backup provider: Groq (free tier) -- https://console.groq.com/keys
GROQ_API_KEY=

# Provider selection: gemini | groq | mock
LLM_PROVIDER=gemini
# Model id. gemini default: gemini-3.5-flash-lite ; groq default: llama-3.3-70b-versatile
LLM_MODEL=gemini-3.5-flash-lite

# Client-side free-tier guard rails (kept deliberately conservative).
LLM_RPM=15
LLM_RPD=500

# Public Gradio demo protection
DEMO_MAX_RUNS_PER_SESSION=5
DEMO_DAILY_CAP=100
